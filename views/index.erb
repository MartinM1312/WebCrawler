<!DOCTYPE html>
<html>
<head>
  <title>Web Scrapper</title>
  <style>
    body { font-family: sans-serif; background-color: #f6f6ef; padding: 20px; }
    .container { max-width: 800px; margin: 0 auto; background: white; padding: 20px; box-shadow: 0 0 10px rgba(0,0,0,0.1); }
    .header { background-color: #ff6600; color: white; padding: 10px; font-weight: bold; }
    table { width: 100%; border-collapse: collapse; margin-top: 20px; }
    th, td { padding: 10px; border-bottom: 1px solid #ddd; text-align: left; }
    .controls { margin-bottom: 20px; padding: 15px; background: #eee; border-radius: 5px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">Hacker News Web Scrapper</div>

    <div class="controls">
      <form action="/" method="GET">
        <select name="filter" id="filter" style="padding: 5px;">
          <option value="all" <%= 'selected' if @filter_type == 'all' %>>
            All Entries
          </option>
          <option value="long_titles" <%= 'selected' if @filter_type == 'long_titles' %>>
            Entries with more than 5 words in the title (Ordered by Number of Comments)
          </option>
          <option value="short_titles" <%= 'selected' if @filter_type == 'short_titles' %>>
            Entries with less than 5 words in the title (Ordered by Points)
          </option>
        </select>
        <button type="submit" style="padding: 6px 15px; cursor: pointer;">Apply</button>
      </form>
    </div>

    <table>
      <thead>
        <tr>
          <th>Rank</th>
          <th>Title</th>
          <th>Points</th>
          <th>Comments</th>
        </tr>
      </thead>
      <tbody>
        <% if @entries && @entries.any? %>
          <% @entries.each do |entry| %>
            <tr>
              <td><%= entry.rank %></td>
              <td><strong><%= entry.title %></strong></td>
              <td><%= entry.points %></td>
              <td><%= entry.comments %></td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="4" style="text-align: center;">No Entries Found</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</body>
</html>